AddDefaultCharset UTF-8
DirectoryIndex index.php
ServerSignature Off
Options -Indexes

RewriteEngine On
RewriteRule "(^|/)\." - [F]
RewriteRule styles\.(.+)\.css ./styles.css [QSA,L]
RewriteRule scripts\.(.+)\.js ./scripts.js [QSA,L]
RewriteRule bridge/(.*) bridge.php

<FilesMatch "\.(ico|jpe?g|png|gif|bmp|tiff|svgz?|html?|js|css|pdf|djvu|zip|tgz|gz|rar|bz2|tar|exe|docx?|xlsx?|pptx?|txt|rtf|swf|flv|f4v|midi?|wav|wmv|ogg|ogv|mp3|mp4|avi|eot|otf|woff)$">
	ExpiresActive On
	ExpiresDefault "access plus 1 year"
	FileETag None
	Header append Cache-Control public
</FilesMatch>

php_value post_max_size						32M
php_value upload_max_filesize				32M
php_value memory_limit						512M
php_value max_execution_time				30
php_value session.gc_maxlifetime			86400
php_value error_reporting					32767
php_flag  display_errors					on
php_flag  log_errors						off
php_flag  display_startup_errors			off
php_value default_charset					UTF-8
php_flag  magic_quotes_gpc					off
php_flag  magic_quotes_runtime				off
php_flag  magic_quotes_sybase				off
php_flag  register_globals					off
php_flag  register_long_arrays				off
php_flag  register_argc_argv				off
php_flag  session.auto_start				off
php_flag  session.use_cookies				on
php_flag  session.use_only_cookies			on
php_flag  session.cookie_httponly			on
php_flag  session.use_trans_sid				off
php_value session.gc_divisor				1000
php_value session.gc_probability			10
php_flag  mbstring.func_overload			off
php_flag  mbstring.encoding_translation		off
php_flag  mbstring.strict_detection			off
php_value mbstring.internal_encoding		UTF-8
php_value mbstring.http_input				UTF-8
php_value mbstring.http_output				UTF-8
php_value mbstring.substitute_character		none
php_flag  output_buffering					off
php_flag  html_errors						off
php_flag  zlib.output_compression			off
php_value zlib.output_compression_level		0
php_flag  short_open_tag					on
php_flag  asp_tags							off
php_flag  allow_url_fopen					on
php_flag  allow_url_include					off

AddType "text/javascript; charset=UTF-8" .js
AddType "text/css; charset=UTF-8" .css
